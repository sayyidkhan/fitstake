# Copy to .env locally (gitignored) and set the same names in Vercel. Server-side only: never use a VITE_ prefix.
TURSO_DATABASE_URL=libsql://fitstake-sayyidkhan.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=
OPENAI_API_KEY=
# Reap Agentic Payments (sandbox base URL: https://sg.sandbox.api.reap.global)
REAP_API_KEY=
REAP_VERSION=2025-02-14
# Optional: set true to send X-Simulate-Checkout: COMPLETED (sandbox only)
REAP_SIMULATE_COMPLETE=false
# Public app URL used as the hosted-page return URL (defaults to VERCEL_URL)
APP_URL=
REAP_BASE_URL=https://sg.sandbox.api.reap.global

# Optional: show illustrative demo items (not purchasable via Reap) alongside real ones. Always on in the local simulator.
ENABLE_DEMO_CATALOGUE=false

# --- Accounts (email-code login) ---
# Random secret, 32+ characters, used to hash login codes. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Easiest: send codes from a Gmail account using a Google "app password" (needs 2-Step Verification on).
# Create one at https://myaccount.google.com/apppasswords. Never use your normal Gmail password here.
GMAIL_USER=benlim631@gmail.com
GMAIL_APP_PASSWORD=
# Alternative: Resend (https://resend.com). EMAIL_FROM must be on a domain you've verified there.
RESEND_API_KEY=
EMAIL_FROM=FitStake <login@yourdomain.com>
# DEMO ONLY: instant sign-in with no email or code (needs no AUTH_SECRET). Anyone can log in as any email while this is true.
AUTH_DEV_CODE=false
